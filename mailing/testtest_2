from django.shortcuts import render
from django.utils import timezone
from .models import Mailing, Client

def dashboard(request):
    now = timezone.now()

    # 1. Общее количество всех рассылок
    total_mailings = Mailing.objects.count()

    # 2. Активные рассылки:
    # - сейчас между start_time и end_time
    # - статус == 'Запущена'
    active_mailings = Mailing.objects.filter(
        start_time__lte=now,
        end_time__gte=now,
        status=Mailing.STATUS_RUNNING
    ).count()

    # 3. Уникальные получатели (все клиенты в системе)
    unique_clients = Client.objects.count()

    context = {
        'total_mailings': total_mailings,
        'active_mailings': active_mailings,
        'unique_clients': unique_clients,
    }

    return render(request, 'mailing/dashboard.html', context)


Важно: Убедись, что в модели Mailing константы статусов совпадают. В предыдущих шагах мы использовали:

