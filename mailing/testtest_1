# В views.py в классе MailingDetailView
def get_context_data(self, **kwargs):
    context = super().get_context_data(**kwargs)
    mailing = context['object']
    attempts = mailing.attempts.all()
    total = attempts.count()
    success = attempts.filter(status='Успешно').count()
    fail = attempts.filter(status='Не успешно').count()
    
    context.update({
        'stats': {
            'total': total,
            'success': success,
            'fail': fail,
            'percent': round((success / total * 100), 1) if total else 0,
        }
    })
    return context


